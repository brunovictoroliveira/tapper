# Variáveis públicas do frontend. Nunca use a service_role no Vite.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima

# Segredos exclusivos das Netlify Functions.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
R2_ACCOUNT_ID=seu-account-id
R2_ACCESS_KEY_ID=sua-access-key
R2_SECRET_ACCESS_KEY=sua-secret-key
R2_BUCKET_NAME=tapper-cloud
APP_URL=https://tapper.example
MERCADO_PAGO_ACCESS_TOKEN=seu-access-token
MERCADO_PAGO_WEBHOOK_SECRET=seu-webhook-secret

# Variáveis legadas do backend FastAPI, mantido apenas como referência.
DOMAIN=musica.seudominio.com

# Ajuste conforme o disco e a CPU disponíveis na instância Oracle.
MAX_UPLOAD_MB=250
MAX_ANALYSIS_SECONDS=180
MAX_CONCURRENT_ANALYSES=1
